# Để trống khi chạy Vite local: /api được proxy tới backend cổng 8001.
# Khi triển khai riêng frontend/backend, điền URL API và cấu hình CORS tương ứng.
VITE_API_BASE_URL=

# Điền cấu hình web app của Firebase để bật Google/Facebook/Phone login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
