APP_NAME=Fake Review Detection API
APP_ENV=development
SECRET_KEY=change-this-to-a-random-32-byte-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./fake_review.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
MODEL_PATH=ml/models/fake_review_model.joblib
MODEL_NAME=tfidf_svm_calibrated
MODEL_VERSION=1.0.0
MODEL_METRICS_PATH=ml/models/fake_review_model.json
AUTO_CREATE_TABLES=true

# URL gốc dùng khi sinh liên kết xác minh sản phẩm/QR
VERIFICATION_BASE_URL=http://127.0.0.1:8000
